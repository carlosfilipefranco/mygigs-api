# Opcional durante a transição: variáveis não preenchidas usam os valores anteriores.
# Gerar segredos novos quando se iniciar a rotação: node scripts/generate-security-env.js
JWT_SECRET=
ADMIN_SESSION_SECRET=

# Utilizador dedicado, sem permissões de administração ou alterações de schema.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Alternativamente: MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
# ou DATABASE_URL/MYSQL_URL. Migrar para um utilizador dedicado durante a rotação.
IMGBB_API_KEY=
SETLISTFM_API_KEY=
NODE_ENV=development
